# ─────────────────────────────────────────────────────────────────────────────
# Simple Migrate Readiness Dashboard — environment variables
# Copy to .env.local for local development. Never commit real values.
# The public marketing site needs none of these.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (all dashboard tables live in the `dashboard` schema).
DATABASE_URL=postgres://localhost:5432/simplemigrate_dev
# Optional direct (non-pooled) URL used only for migrations.
DIRECT_URL=

# Auth (Better Auth). Generate with: openssl rand -base64 33
AUTH_SECRET=
# Public origin of the app (used for links in emails and auth callbacks).
APP_BASE_URL=http://localhost:3000
# Sign-in attempts per IP per minute.
AUTH_SIGNIN_RATE_LIMIT=5

# Email (transactional only). EMAIL_DRIVER=log prints emails to the server log
# and shows invite links to admins — use only for local/non-public servers.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM="Simple Migrate <no-reply@simplemigrate.com>"

# Document storage. "local" is for development only; use "s3" (ca-central-1)
# for any shared environment.
STORAGE_DRIVER=local
S3_REGION=ca-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI assist (server-side only).
ANTHROPIC_API_KEY=

# Vercel Cron authentication.
CRON_SECRET=

# CREA DDF® — leave unset until a signed feed agreement exists.
DDF_USERNAME=
DDF_PASSWORD=

# Map provider for property search.
MAPBOX_TOKEN=

# Feature flags (default off).
FEATURE_AI=false
FEATURE_DDF=false
# Must stay false until counsel confirms referral fees are permitted.
FEATURE_AGENT_REFERRAL_FEES=false

# Local development only: skip forced MFA enrolment for staff roles.
# Ignored when NODE_ENV=production.
DASH_DEV_SKIP_MFA=false

# Seed password for local sample accounts (npm run db:seed).
SEED_PASSWORD=

# ── Public site analytics ────────────────────────────────────────────────────
# Set ONLY in Vercel's Production environment so dev/preview traffic is never
# tracked. Loaded on the public site only — never on the /app dashboard.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
