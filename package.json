{
  "name": "maxcoach-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build && next export",
    "format": "prettier --ignore-path .prettierignore --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "rimraf *.tsbuildinfo .next out yarn-error.log",
    "clean-all": "rimraf *.tsbuildinfo node_modules .husky .next out yarn-error.log",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "next lint",
    "lint:fix": "yarn typecheck & yarn format & yarn lint --fix",
    "prepare": "husky install",
    "postbuild": "next-sitemap",
    "test:visual": "playwright test e2e/public-visual.spec.ts",
    "test:e2e": "playwright test",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/dashboard/migrate.ts",
    "db:seed": "tsx scripts/dashboard/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/dashboard/reset-local.ts && npm run db:migrate && npm run db:seed",
    "dashboard:css": "node scripts/dashboard/build-css.mjs",
    "prebuild": "npm run -s dashboard:css",
    "predev": "npm run -s dashboard:css",
    "dev:css": "node scripts/dashboard/build-css.mjs --watch"
  },
  "dependencies": {
    "@googlemaps/react-wrapper": "^1.1.35",
    "@googlemaps/typescript-guards": "^2.0.3",
    "better-auth": "1.7",
    "clsx": "^1.2.1",
    "dayjs": "^1.11.6",
    "disqus-react": "^1.1.3",
    "drizzle-orm": "^0.45.4",
    "fast-equals": "^4.0.3",
    "framer-motion": "^7.6.7",
    "gray-matter": "^4.0.3",
    "loading-attribute-polyfill": "^2.1.0",
    "marked": "^4.2.2",
    "next": "14.2",
    "next-pwa": "^5.6.0",
    "next-react-svg": "https://github.com/hasanm95/next-react-svg",
    "next-seo": "^5.14.1",
    "next-sitemap": "^3.1.32",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.39.4",
    "react-simple-typewriter": "^4.0.5",
    "server-only": "^0.0.1",
    "swiper": "^8.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.8",
    "@types/google.maps": "^3.50.5",
    "@types/marked": "^4.0.7",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@types/react-portal": "^4.0.4",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "autoprefixer": "^10.4.13",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.27.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "14.2",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.10",
    "husky": "^8.0.2",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.19",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "tailwindcss": "^3.2.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
