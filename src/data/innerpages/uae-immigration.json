        {
            "section": "faq-area",
            "section_title": {
                "title": "UAE Visa FAQs",
                "subtitle":"Practical guidance on requirements, costs, ownership, and residency benefits for global entrepreneurs."
            },
            "items": [
                {
                    "id": 1,
                    "title": " What is the minimum investment required for UAE residency?",
                    "description": "Investment requirements depend on the program. The Golden Visa typically requires AED 2M+ in qualifying investments, while Free Zone and Investor Visas may require significantly lower capital depending on the business structure. We assess your profile and recommend the most cost-efficient pathway."
                },
                {
                    "id": 2,
                    "title": "Can I own 100% of my business in the UAE?",
                    "description": "Yes. Many Free Zones allow 100% foreign ownership, and recent mainland reforms also permit full ownership in most sectors. We structure your setup to ensure maximum control and flexibility."
                },
                {
                    "id": 3,
                    "title": "How long does the UAE visa process take?",
                    "description": "Most business and investor visas can be processed within a few weeks once documentation is complete. Fast-track options may be available depending on the emirate and program selected."
                },
                {
                    "id": 4,
                    "title": " Can I include my family in my UAE residency?",
                    "description": "Yes. Most UAE investor and entrepreneur visas allow you to sponsor your spouse and children, and in some cases domestic staff, providing full relocation support for your family."
                },
                {
                    "id": 5,
                    "title": "Do I need a local sponsor to apply?",
                    "description": "No. Golden, Green, Investor, and Free Zone visas are generally self-sponsored through your business or investment, giving you independence and control over your residency status."
                },
                {
                    "id": 6,
                    "title": "Is the UAE tax-free?",
                    "description": "The UAE offers a highly tax-efficient environment with no personal income tax. Corporate tax may apply depending on business activity and revenue thresholds, but the UAE remains one of the most attractive global jurisdictions for entrepreneurs and investors."
                }
            ]
        }
